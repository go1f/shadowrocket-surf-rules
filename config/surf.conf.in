# shadowrocket-surf-rules by go1f
# 在「全局路由」选择「配置」。配置和服务器订阅分别管理。
[General]
ipv6 = true
prefer-ipv6 = false
# 国内 DoH 主解析，海外 DoH 和阿里 DoT 备用。IP 端点无需引导解析。
dns-server = https://223.5.5.5/dns-query,https://120.53.53.53/dns-query
fallback-dns-server = https://1.0.0.1/dns-query,https://8.8.8.8/dns-query,tls://223.5.5.5
dns-direct-system = false
dns-fallback-system = false
dns-direct-fallback-proxy = false
hijack-dns = :53
udp-policy-not-supported-behaviour = REJECT
skip-proxy = localhost,*.local,captive.apple.com
# 只让链路本地的 mDNS 组播绕过 TUN，公网 DNS 仍由配置接管。
tun-excluded-routes = 224.0.0.251/32,ff02::fb/128

[Rule]
# ChatGPT 网页、App、认证、附件、WebSocket
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,openai.com,PROXY
DOMAIN-SUFFIX,oaistatic.com,PROXY
DOMAIN-SUFFIX,oaiusercontent.com,PROXY
DOMAIN-SUFFIX,oaistatsig.com,PROXY
DOMAIN,cdn.openaimerge.com,PROXY
DOMAIN,challenges.cloudflare.com,PROXY
DOMAIN,cdn.workos.com,PROXY
DOMAIN,forwarder.workos.com,PROXY
DOMAIN,frontend-apps-multi-region.workos.com,PROXY
DOMAIN,images.workoscdn.com,PROXY
DOMAIN,setup.workos.com,PROXY
DOMAIN,workos.imgix.net,PROXY
DOMAIN,dns-detect.alicdn.com,PROXY

# Apple Music 播放和媒体域名优先直连。
DOMAIN-SUFFIX,music.apple.com,DIRECT
DOMAIN-SUFFIX,applemusic.com,DIRECT
DOMAIN,aod.itunes.apple.com,DIRECT
DOMAIN,aod-ssl.itunes.apple.com,DIRECT
DOMAIN,audio.itunes.apple.com,DIRECT
DOMAIN,audio-ssl.itunes.apple.com,DIRECT
DOMAIN,mvod.itunes.apple.com,DIRECT
DOMAIN,streamingaudio.itunes.apple.com,DIRECT

# 加密 DNS、局域网和 iOS 强制门户探测
IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
IP-CIDR,120.53.53.53/32,DIRECT,no-resolve
IP-CIDR,1.0.0.1/32,DIRECT,no-resolve
IP-CIDR,8.8.8.8/32,DIRECT,no-resolve
DOMAIN,captive.apple.com,DIRECT
DOMAIN,localhost,DIRECT
DOMAIN-SUFFIX,local,DIRECT
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve
IP-CIDR6,fc00::/7,DIRECT,no-resolve
IP-CIDR6,fe80::/10,DIRECT,no-resolve

# 微信聊天图片上传与查看、朋友圈视频及视频号媒体
