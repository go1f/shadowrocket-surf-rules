DOMAIN,yun-hl.3g.qq.com,DIRECT
DOMAIN,vweixinf.tc.qq.com,DIRECT
DOMAIN,vweixinthumb.tc.qq.com,DIRECT
DOMAIN,wxapp.tc.qq.com,DIRECT
DOMAIN,finder.video.qq.com,DIRECT

# 广告拦截优先于常用国内域名直连
